# Copy to .env and fill in. Without a key the gateway runs on the mock provider,
# which is a fully working demo -- just with simulated answers.
GROQ_API_KEY=

# Force the mock even when a key is set (the load test uses this).
FORCE_MOCK=false

# "registry" loads the @champion from MLflow; "local" reads models/router.joblib.
MODEL_SOURCE=registry
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Confidence below which a `moderate` query is sent to the expensive model.
# See docs/pareto.png and RESULTS.md for how this value was chosen.
ROUTER_THRESHOLD=0.60
